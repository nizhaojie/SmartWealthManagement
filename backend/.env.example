# ==============================================================================
# 智能财富管家系统 — 后端环境配置模板
#
# 用法：复制本文件为 backend/.env，填入真实 key。.env 已在 .gitignore 中，
#       不会被提交；本模板不含任何密钥，进版本库。
#
# 端口说明：所有服务端口都刻意错开默认值，避免与机器上其他项目冲突。
# ==============================================================================

# ---- MySQL（唯一写入源 / ledger）-------------------------------------------
DATABASE_URL=mysql+pymysql://wealth_app:wealth_app_pw@127.0.0.1:3307/wealth
TEST_DATABASE_URL=mysql+pymysql://wealth_app:wealth_app_pw@127.0.0.1:3307/wealth_test

# root 连接仅用于创建数据分析 Agent 的受限执行账号（迁移账号没有
# CREATE USER / GRANT 权限）；日常运行不需要。
MYSQL_ROOT_URL=mysql+pymysql://root:root_pw@127.0.0.1:3307
# 受限执行账号：只对语义视图有 SELECT 权限，对基础表无任何权限（ADR-0010）。
ANALYTICS_DB_USER=wealth_analytics
ANALYTICS_DB_PASSWORD=wealth_analytics_pw
# 结果行数上限：超出时截断并在响应中带截断标记。
ANALYTICS_MAX_ROWS=200
# 查询超时上限（MySQL max_execution_time，毫秒）。
ANALYTICS_QUERY_TIMEOUT_MS=5000
# 「问题 → 查询」示例文件；留空则使用随仓库提供的 query_examples.json。
ANALYTICS_EXAMPLES_PATH=

# ---- Redis（短期记忆 / 画像缓存 / Pub-Sub 事件总线）-------------------------
REDIS_URL=redis://127.0.0.1:6380/0
TEST_REDIS_URL=redis://127.0.0.1:6380/1

# ---- Milvus（知识库向量）----------------------------------------------------
MILVUS_URI=http://127.0.0.1:19531
MILVUS_COLLECTION=knowledge_chunks
TEST_MILVUS_COLLECTION=knowledge_chunks_test

# ---- Neo4j（MySQL 的投影读模型，只读；由 MySQL 单向同步生成，脏了就全量重建）
NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=wealth_neo4j_pw

# ---- MinIO（知识库原始文档）------------------------------------------------
MINIO_ENDPOINT=127.0.0.1:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=wealth-knowledge
MINIO_SECURE=false

# ---- JWT（两个身份域：客户与员工的凭证互不通用，靠 audience 隔离）----------
# HS256 密钥必须 ≥32 字节，否则 PyJWT 发 InsecureKeyLengthWarning。这里的
# 占位符只是开发用，生产环境务必换成一份等长（或更长）的随机密钥。
JWT_SECRET=change-me-before-any-real-use-32bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CUSTOMER_TOKEN_AUDIENCE=customer-app
INTERNAL_TOKEN_AUDIENCE=internal-app

# ==============================================================================
# LLM —— Chat 与 Embedding 分开配置
#
# 两者必须分开，因为它们未必来自同一家：DeepSeek 只提供生成模型，没有
# embedding 接口，所以「chat 走 DeepSeek + embedding 走通义」是常见组合。
#
# provider 取值只有两个：
#
#   fake               —— 不调用真实模型，返回确定性假数据（跑测试 / 无网络时用）
#
#   openai_compatible  —— 指「遵循 OpenAI 接口格式的服务」，不是指 OpenAI 这家
#                         公司。通义百炼、DeepSeek、OpenAI 官方全都填这一个值，
#                         区别只在下面三个变量。代码认的是协议，不是厂商。
#
# 所以：用通义，PROVIDER 也填 openai_compatible。
# ==============================================================================

# ---- Chat 模型 --------------------------------------------------------------
LLM_PROVIDER=fake
LLM_MODEL_NAME=
LLM_API_BASE=
LLM_API_KEY=

# 示例 A：通义千问（和下面 embedding 用同一个 key，最省事，推荐）
#   LLM_PROVIDER=openai_compatible
#   LLM_MODEL_NAME=qwen-plus
#   LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_API_KEY=<你的 DashScope API Key>
#
# 示例 B：DeepSeek（chat 更便宜，但它没有 embedding 接口，
#         下面的 embedding 仍须填通义，于是你需要两个厂商的两个 key）
#   LLM_PROVIDER=openai_compatible
#   LLM_MODEL_NAME=deepseek-chat
#   LLM_API_BASE=https://api.deepseek.com/v1
#   LLM_API_KEY=<你的 DeepSeek API Key>

# ---- Embedding 模型 ---------------------------------------------------------
# 用通义时，PROVIDER 同样填 openai_compatible：
#   EMBEDDING_PROVIDER=openai_compatible
#   EMBEDDING_API_KEY=<你的 DashScope API Key>
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL_NAME=text-embedding-v3
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=

# ⚠️ 维度一旦写入 Milvus 集合就不可更改，改了必须删集合、重灌全部向量。
#    动手建库之前先确认这个值。
#    text-embedding-v3 支持 1024(默认)/768/512/256/128/64
#    text-embedding-v4 额外支持 2048/1536
EMBEDDING_DIMENSION=1024

# ---- 智能客服 Agent（短期记忆 / 检索兜底阈值）--------------------------------
# 兜底判定是**分臂判定**：向量臂最高余弦、关键词臂最高 BM25、图谱段落三者
# 任一达标即认为有依据。两条阈值量纲不同，不能互相套用。
#
# 两条阈值都由校准脚本在 golden 集上量出，不是手写的经验值：
#     cd backend && python -m scripts.calibrate_retrieval
# 下面括号里记着产出它们的那次校准（语料 = 10 文档 / 348 分块，text-embedding-v3）。
# 语料或 embedding 模型一变，两条分布都会移（BM25 的 df / avgdl 在全语料上统计），
# 必须按同一脚本重跑、人工复核后改这里。
#
# 向量臂阈值：无关负例最高余弦 0.46，语义正例最低 0.68。
RETRIEVAL_SCORE_THRESHOLD=0.57
# 关键词臂阈值：量纲是 BM25 分（不再是「命中字词占比」），且随语料规模漂移。
# 同一次校准：无关负例最高 10.63，字面 / FAQ 正例最低 15.52。
RETRIEVAL_KEYWORD_SCORE_THRESHOLD=13
# 每个召回臂各自返回的候选数（向量臂与关键词臂各出这么多条，再 RRF 融合）。
HYBRID_RECALL_TOP_K=20
# RRF 平滑常数：rrf_score = Σ 1/(RRF_K + rank_arm)。只用位次，跨量纲。
RRF_K=60
# 可选的 jieba 用户词典路径（一行一个词）；文件不存在则跳过。本 slice 不提供词表。
JIEBA_USER_DICT_PATH=
# 重排（把 RRF 候选交给一次模型调用重排序）开关。关掉后直接用 RRF 序；
# fake provider 与回放模式恒等保序、不发调用（跳过不记降级留痕）。
RERANK_ENABLED=true
# 重排单次调用的墙钟超时（秒）。它独立于主链路的 LLM_TIMEOUT_SECONDS：重排是增强，
# 单次调用、不重试、不切备用配置——套用主链路那套会把 2s 的检索变成 30s+。
RERANK_TIMEOUT_SECONDS=5
# 重排专用模型：重排与回答可以用不同的模型（重排通常用更小更快的）。三个变量
# 没配全时回落上面的主配置（LLM_*），行为与不分离时完全一致；配全了才走独立模型。
# 该配置同样不重试、不切备用——失败就退回 RRF 序并记降级留痕。
#   RERANK_LLM_MODEL_NAME=qwen-flash
#   RERANK_LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
#   RERANK_LLM_API_KEY=<你的 DashScope API Key>
RERANK_LLM_MODEL_NAME=
RERANK_LLM_API_BASE=
RERANK_LLM_API_KEY=
# 短期记忆滑动过期时间；每次追问都会刷新。
CHAT_MEMORY_TTL_MINUTES=30
# 短期记忆的 token 预算，超出后从最旧的消息开始截断。
CHAT_MEMORY_TOKEN_BUDGET=2000
# 兜底话术与转人工话术中展示的人工客服热线。
HUMAN_SERVICE_CHANNEL=95588

# ---- 降级路径：超时阈值（都可调，改策略不改代码）-----------------------------
# 模型调用：单次超时 → 同一配置内指数退避重试 → 备用配置 → 预设兜底回答。
LLM_TIMEOUT_SECONDS=30
# 重试次数；总调用次数 = 1 + 重试次数，间隔按退避基数翻倍（1s / 2s / 4s）。
LLM_MAX_RETRIES=3
# 退避基数（秒）：第 n 次重试前等 backoff * 2^(n-1)。
LLM_RETRY_BACKOFF_SECONDS=1
# 备用模型（OpenAI → 本地 Qwen）。未填 BACKUP_API_KEY 时整条链路跳过。
LLM_BACKUP_MODEL_NAME=
LLM_BACKUP_API_BASE=
LLM_BACKUP_API_KEY=
# 向量检索墙钟超时（秒）；超时只是少了一路召回，结果退回只用关键词臂（BM25）。
VECTOR_SEARCH_TIMEOUT_SECONDS=2
# GraphRAG 图谱查询墙钟超时（秒）；超时跳过增强，只用向量结果。
GRAPHRAG_QUERY_TIMEOUT_SECONDS=3
# 关系图可视化入口的墙钟超时（秒）；超时返回空图而不是 500。
GRAPH_VIEW_TIMEOUT_SECONDS=3
# Neo4j 建连超时（秒）。
NEO4J_CONNECTION_TIMEOUT_SECONDS=2
# 缓存连接与读写超时（秒）；不设时一次挂起的连接会把请求线程吊住。
REDIS_CONNECT_TIMEOUT_SECONDS=2
REDIS_SOCKET_TIMEOUT_SECONDS=2

# ---- 画像置信度：综合重排与周期校准 -----------------------------------------
# 周期校准把时间衰减后置信度低于该阈值的画像标签标记为已过期。
PROFILE_TAG_EXPIRY_THRESHOLD=0.4
# 周期校准的间隔（分钟），缺省每天一次；进程内调度，不引入分布式任务队列。
CALIBRATION_INTERVAL_MINUTES=1440
# 综合重排的场景权重覆盖（JSON）。只写要调整的场景，其余用代码内缺省表——
# 四个场景：customer_service / product_recommendation / risk_analysis / profile_review。
# 五个因子：semantic_similarity / recency / historical_accuracy / base_confidence / conflict_penalty。
# CONFIDENCE_RERANK_WEIGHTS={"product_recommendation": {"semantic_similarity": 0.6}}

# ---- 演示回放模式 -----------------------------------------------------------
# 开启后，预置问答走确定性回放，不依赖 LLM 与向量库是否健康。
# 用途：答辩现场兜底（网络或容器抖动不至于让演示当场挂掉），兼作集成测试夹具。
# 日常开发保持 false，走真实链路。
# 一键进入：pnpm demo（等价于 DEMO_REPLAY=1 启动后端 + 两个前端）。
DEMO_REPLAY=false
