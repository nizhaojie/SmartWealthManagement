# ==============================================================================
# 智能财富管家系统 — 后端环境配置模板
#
# 用法：复制本文件为 backend/.env，填入真实 key。.env 已在 .gitignore 中，
#       不会被提交；本模板不含任何密钥，进版本库。
#
# 端口说明：所有服务端口都刻意错开默认值，避免与机器上其他项目冲突。
# ==============================================================================

# ---- MySQL（唯一写入源 / ledger）-------------------------------------------
DATABASE_URL=mysql+pymysql://wealth_app:wealth_app_pw@127.0.0.1:3307/wealth
TEST_DATABASE_URL=mysql+pymysql://wealth_app:wealth_app_pw@127.0.0.1:3307/wealth_test

# ---- Redis（短期记忆 / 画像缓存 / Pub-Sub 事件总线）-------------------------
REDIS_URL=redis://127.0.0.1:6380/0
TEST_REDIS_URL=redis://127.0.0.1:6380/1

# ---- Milvus（知识库向量）----------------------------------------------------
MILVUS_URI=http://127.0.0.1:19531
MILVUS_COLLECTION=knowledge_chunks
TEST_MILVUS_COLLECTION=knowledge_chunks_test

# ---- Neo4j（MySQL 的投影读模型，只读；由 MySQL 单向同步生成，脏了就全量重建）
NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=wealth_neo4j_pw

# ---- MinIO（知识库原始文档）------------------------------------------------
MINIO_ENDPOINT=127.0.0.1:9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=wealth-knowledge
MINIO_SECURE=false

# ---- JWT（两个身份域：客户与员工的凭证互不通用，靠 audience 隔离）----------
JWT_SECRET=change-me-before-any-real-use
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
CUSTOMER_TOKEN_AUDIENCE=customer-app
INTERNAL_TOKEN_AUDIENCE=internal-app

# ==============================================================================
# LLM —— Chat 与 Embedding 分开配置
#
# 两者必须分开，因为它们未必来自同一家：DeepSeek 只提供生成模型，没有
# embedding 接口，所以「chat 走 DeepSeek + embedding 走通义」是常见组合。
#
# provider 取值只有两个：
#
#   fake               —— 不调用真实模型，返回确定性假数据（跑测试 / 无网络时用）
#
#   openai_compatible  —— 指「遵循 OpenAI 接口格式的服务」，不是指 OpenAI 这家
#                         公司。通义百炼、DeepSeek、OpenAI 官方全都填这一个值，
#                         区别只在下面三个变量。代码认的是协议，不是厂商。
#
# 所以：用通义，PROVIDER 也填 openai_compatible。
# ==============================================================================

# ---- Chat 模型 --------------------------------------------------------------
LLM_PROVIDER=fake
LLM_MODEL_NAME=
LLM_API_BASE=
LLM_API_KEY=

# 示例 A：通义千问（和下面 embedding 用同一个 key，最省事，推荐）
#   LLM_PROVIDER=openai_compatible
#   LLM_MODEL_NAME=qwen-plus
#   LLM_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_API_KEY=<你的 DashScope API Key>
#
# 示例 B：DeepSeek（chat 更便宜，但它没有 embedding 接口，
#         下面的 embedding 仍须填通义，于是你需要两个厂商的两个 key）
#   LLM_PROVIDER=openai_compatible
#   LLM_MODEL_NAME=deepseek-chat
#   LLM_API_BASE=https://api.deepseek.com/v1
#   LLM_API_KEY=<你的 DeepSeek API Key>

# ---- Embedding 模型 ---------------------------------------------------------
# 用通义时，PROVIDER 同样填 openai_compatible：
#   EMBEDDING_PROVIDER=openai_compatible
#   EMBEDDING_API_KEY=<你的 DashScope API Key>
EMBEDDING_PROVIDER=fake
EMBEDDING_MODEL_NAME=text-embedding-v3
EMBEDDING_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=

# ⚠️ 维度一旦写入 Milvus 集合就不可更改，改了必须删集合、重灌全部向量。
#    动手建库之前先确认这个值。
#    text-embedding-v3 支持 1024(默认)/768/512/256/128/64
#    text-embedding-v4 额外支持 2048/1536
EMBEDDING_DIMENSION=1024

# ---- 演示回放模式 -----------------------------------------------------------
# 开启后，预置问答走确定性回放，不依赖 LLM 与向量库是否健康。
# 用途：答辩现场兜底（网络或容器抖动不至于让演示当场挂掉），兼作集成测试夹具。
# 日常开发保持 false，走真实链路。
DEMO_REPLAY=false
